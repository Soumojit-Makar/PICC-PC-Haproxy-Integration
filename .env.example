# ==============================================================================
# PICC-PC-Haproxy-Integration - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens (Default: 8081)
SERVER_PORT=8081

# Active Spring Profile (e.g., main, dev, local)
SPRING_PROFILES_ACTIVE=main

# ------------------------------------------------------------------------------
# 2. HAProxy DataPlane API v3 Integration
# ------------------------------------------------------------------------------
# Feign client identifier
HAPROXY_FEIGN_NAME=haproxy-data-plane

# Base URL of the HAProxy DataPlane API instance
HAPROXY_DATAPLANE_URL=http://localhost:5555

# DataPlane API version path prefix
FEIGN_URL_API=/v3/services/haproxy

# HAProxy DataPlane API Basic Authentication Credentials
HAPROXY_DATAPLANE_USER=dataplaneapi
HAPROXY_DATAPLANE_PASSWORD=yourSecretDataPlanePasswordHere

# ------------------------------------------------------------------------------
# 3. Kubernetes Cluster Integration (Pre-Registration Validation)
# ------------------------------------------------------------------------------
# Master node IP address or Kubernetes API endpoint
K8S_MASTER_IP=127.0.0.1

# Kubernetes API server port (Default: 6443)
K8S_SERVER_PORT=6443

# Bearer Token for authenticating against Kubernetes API /api/v1/namespaces/{namespace}/pods
K8S_CLUSTER_TOKEN=yourSecretK8sBearerTokenHere

# Enable/disable pre-registration pod running status check (Default: true)
HAPROXY_K8S_VALIDATION_ENABLED=true

# Strict mode: if true, fails registration when pod is not running; if false, logs warning
HAPROXY_K8S_STRICT_MODE=false

# ------------------------------------------------------------------------------
# 4. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
# Centralized configuration server URL (if used)
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_LABEL=v1

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Log level for HAProxy integration (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO
FEIGN_LOG_LEVEL=WARN
